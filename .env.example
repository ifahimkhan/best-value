# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Bypasses row level security. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store payments (Razorpay Dashboard > Account & Settings > API Keys / Webhooks).
# Online checkout stays off until all three are set. Key secret and webhook
# secret are server only. Webhook URL: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seller details printed on GST invoices. SELLER_STATE decides CGST+SGST vs IGST.
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=
